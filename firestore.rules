rules_version = '2';

// Reglas de Firestore para RepartoApp.
// MVP: no hay login con usuario/contraseña todavía (el chofer solo elige su nombre),
// así que como mínimo pedimos que la app haya iniciado sesión anónima de Firebase
// (signInAnonymously, desde el cliente) antes de tocar cualquier dato — evita que
// alguien lea/escriba la base solo por tener la URL pública de la app, sin agregar
// fricción para el chofer. Si más adelante se suma login real, esto se puede ajustar
// para atar cada escritura al chofer autenticado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /guias/{guiaId} {
      allow read, write: if request.auth != null;

      match /clientes/{clienteId} {
        allow read, write: if request.auth != null;
      }
    }

    // Lista de choferes del desplegable de login: la lee cualquier sesión autenticada
    // (chofer anónimo o admin real), pero solo el panel de admin (sesión NO anónima) puede
    // agregar o sacar choferes.
    match /choferes/{choferId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
  }
}
